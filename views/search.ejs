<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Palspider</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/style.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">
  <div class="container my-auto">
    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-6 text-center">

        <h1 class="display-1 fw-bold mb-1">Palspider</h1>
        <p class="text-secondary mb-4">search the open web</p>

        <% if (locals.error) { %>
          <div class="alert alert-danger py-2"><%= error %></div>
        <% } %>
        <% if (locals.crawlMsg === 'started') { %>
          <div class="alert alert-info py-2">Crawl started — indexing in background</div>
        <% } %>

        <form action="/search" method="GET" class="mb-3" role="search">
          <div class="input-group input-group-lg">
            <input type="text" name="q" class="form-control form-control-lg rounded-start-4 border-end-0"
                   placeholder="Search..." value="<%= query %>" autofocus
                   autocomplete="off" id="search-input">
            <button class="btn btn-light rounded-end-4" type="submit">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
              </svg>
            </button>
          </div>
        </form>

        <div id="suggestions" class="list-group text-start mx-auto d-none" style="max-width: 528px; position: absolute;"></div>

        <div class="mt-4">
          <form action="/crawl" method="POST" class="row g-2 justify-content-center">
            <div class="col-auto">
              <input type="url" name="url" class="form-control form-control-sm"
                     placeholder="Seed a URL to auto-crawl..." style="width: 340px;" required>
            </div>
            <div class="col-auto">
              <button class="btn btn-outline-light btn-sm" type="submit">Crawl</button>
            </div>
          </form>
        </div>

        <p class="text-secondary small mt-4">
          <span id="docCount"><%= stats.documents %></span> pages indexed &middot;
          <span id="termCount"><%= stats.terms %></span> terms
          <span id="crawlIndicator" class="d-none ms-2">
            <span class="spinner-border spinner-border-sm" role="status"></span> crawling...
          </span>
        </p>

      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const input = document.getElementById('search-input');
    const suggestions = document.getElementById('suggestions');
    let timer;

    input.addEventListener('input', () => {
      clearTimeout(timer);
      const q = input.value.trim();
      if (q.length < 2) {
        suggestions.classList.add('d-none');
        return;
      }
      timer = setTimeout(async () => {
        const res = await fetch('/suggest?q=' + encodeURIComponent(q));
        const words = await res.json();
        suggestions.innerHTML = words.map(w =>
          `<a href="/search?q=${encodeURIComponent(w)}" class="list-group-item list-group-item-action py-1">${w}</a>`
        ).join('');
        suggestions.classList.toggle('d-none', words.length === 0);
      }, 200);
    });

    document.addEventListener('click', (e) => {
      if (!input.contains(e.target) && !suggestions.contains(e.target)) {
        suggestions.classList.add('d-none');
      }
    });

    async function pollCrawl() {
      const res = await fetch('/crawl-status');
      const status = await res.json();
      const indicator = document.getElementById('crawlIndicator');
      if (status.crawling) {
        indicator.classList.remove('d-none');
        setTimeout(pollCrawl, 2000);
      } else {
        indicator.classList.add('d-none');
      }
    }
    pollCrawl();
  </script>
</body>
</html>
