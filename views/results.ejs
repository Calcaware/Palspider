<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= query %> - Palspider</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/style.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">
  <header class="border-bottom border-secondary-subtle py-3">
    <div class="container">
      <div class="row align-items-center g-2">
        <div class="col-auto">
          <a href="/" class="text-decoration-none text-light">
            <h4 class="fw-bold mb-0">Palspider</h4>
          </a>
        </div>
        <div class="col">
          <form action="/search" method="GET" role="search">
            <div class="input-group">
              <input type="text" name="q" class="form-control" value="<%= query %>" autofocus>
              <button class="btn btn-light" type="submit">Search</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </header>

  <main class="container my-4">
    <% if (results.length === 0) { %>
      <div class="text-center py-5">
        <h5>No results for "<%= query %>"</h5>
        <p class="text-secondary">Try different keywords or <a href="/" class="text-light">index more pages</a>.</p>
      </div>
    <% } else { %>
      <p class="text-secondary mb-3">
        <%= results.length %> results for "<strong class="text-light"><%= query %></strong>"
      </p>
      <div class="row">
        <div class="col-12 col-lg-8">
          <% results.forEach(r => { %>
            <div class="mb-4">
              <a href="<%= r.url %>" class="text-success small text-break"><%= r.url %></a>
              <h5 class="mb-1">
                <a href="<%= r.url %>" class="text-light text-decoration-none"><%= r.title %></a>
              </h5>
              <p class="text-secondary mb-1 small"><%= r.text.slice(0, 300).trim() %>...</p>
              <span class="badge bg-secondary-subtle text-secondary-emphasis">score: <%= r.score %></span>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
  </main>

  <footer class="mt-auto border-top border-secondary-subtle py-3 text-center text-secondary small">
    <%= stats.documents %> pages indexed &middot; <%= stats.terms %> terms
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
